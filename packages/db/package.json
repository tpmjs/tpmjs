{
  "name": "@tpmjs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify-counter-invariants": "tsx scripts/verify-counter-invariants.ts",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-usernames": "tsx prisma/backfill-usernames.ts",
    "type-check": "tsc --checkers 1 --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "@tpmjs/npm-client": "workspace:*"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "@types/node": "^25.0.3",
    "prisma": "^6.19.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:"
  }
}
