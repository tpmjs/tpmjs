{
  "name": "@tpmjs/tools-jq",
  "version": "0.1.0",
  "description": "jq JSON processing tools for AI agents. Query, filter, and format JSON data using jq expressions.",
  "type": "module",
  "keywords": [
    "tpmjs",
    "jq",
    "json",
    "query",
    "filter",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "ai": "6.0.49"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tpmjs/tpmjs.git",
    "directory": "packages/tools/official/jq"
  },
  "homepage": "https://tpmjs.com",
  "license": "MIT",
  "tpmjs": {
    "category": "utilities",
    "frameworks": [
      "vercel-ai"
    ],
    "tools": [
      {
        "name": "query",
        "description": "Run a jq expression on JSON input. Supports filtering, mapping, and transforming JSON data."
      },
      {
        "name": "format",
        "description": "Pretty-print JSON with consistent formatting."
      }
    ]
  }
}
