[
  {
    "name": "ham_remember",
    "description": "Store a memory in the Galaxy Brain knowledge base. Use this to save findings, decisions, observations, or any information worth remembering across sessions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "The memory content to store" },
        "title": { "type": "string", "description": "Short title for the memory" },
        "cues": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": "Exact agent-authored anchors for multi-hop retrieval; omitted means no cues"
        },
        "type": {
          "type": "string",
          "enum": [
            "observation",
            "fact",
            "decision",
            "preference",
            "finding",
            "handoff",
            "session_summary",
            "code",
            "conversation",
            "note"
          ],
          "description": "Type of memory"
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Shared scopes such as shared, project:ham, or repo:MonumentalSystems/ham"
        },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "thread": { "type": "string" },
        "sequence": {
          "type": "string",
          "description": "Explicit temporal lane; thread is used only as a compatibility fallback"
        },
        "status": {
          "type": "string",
          "description": "Optional state such as active, decided, blocked, or complete"
        },
        "durability": {
          "type": "string",
          "enum": ["ephemeral", "short", "project", "durable", "foundational"],
          "description": "Expected lifetime: debug/session, bug/deploy state, project state, architecture, or enduring invariant"
        },
        "visibility": { "type": "string", "enum": ["shared", "private"], "default": "shared" },
        "idempotency_key": {
          "type": "string",
          "description": "Stable retry key to prevent duplicate writes"
        },
        "links": {
          "type": "array",
          "description": "Typed relations from this memory to existing memory IDs",
          "items": {
            "type": "object",
            "properties": {
              "target_id": { "type": "integer" },
              "relation": {
                "type": "string",
                "enum": ["cites", "verifies", "contradicts", "depends-on"]
              }
            },
            "required": ["target_id", "relation"]
          }
        }
      },
      "required": ["content"]
    }
  },
  {
    "name": "ham_recall",
    "description": "Search shared memory with local learned semantics, harmonic resonance, and lexical matching.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Natural language search query" },
        "top_k": {
          "type": "integer",
          "description": "Number of results (default 5)",
          "default": 5
        },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "source_agents": { "type": "array", "items": { "type": "string" } },
        "explain": {
          "type": "boolean",
          "default": false,
          "description": "Include weighted ranking components for each result"
        }
      },
      "required": ["query"]
    }
  },
  {
    "name": "ham_recall_deep",
    "description": "Scoped semantic search followed by bounded cue, reference, and typed-link traversal with visible hop provenance.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Search query" },
        "top_k": { "type": "integer", "default": 5 },
        "max_hops": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "description": "How many bounded cue-link hops to follow (default 1)",
          "default": 1
        },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "source_agents": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["query"]
    }
  },
  {
    "name": "ham_recall_sequence",
    "description": "Retrieve a deterministic chronological window around one scoped memory anchor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Semantic query used to choose the anchor" },
        "anchor_id": { "type": "integer", "minimum": 1 },
        "sequence": { "type": "string", "description": "Optional explicit temporal lane" },
        "clock": { "type": "string", "enum": ["event", "ingest"], "default": "event" },
        "before": { "type": "integer", "minimum": 0, "maximum": 50, "default": 3 },
        "after": { "type": "integer", "minimum": 0, "maximum": 50, "default": 5 },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "source_agents": { "type": "array", "items": { "type": "string" } }
      },
      "oneOf": [
        { "required": ["query"], "not": { "required": ["anchor_id"] } },
        { "required": ["anchor_id"], "not": { "required": ["query"] } }
      ]
    }
  },
  {
    "name": "ham_reflect",
    "description": "End-of-session reflection. Stores observations and runs durability-aware tier consolidation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "content": { "type": "string" },
              "cues": {
                "type": "array",
                "maxItems": 32,
                "items": { "type": "string", "minLength": 1, "maxLength": 200 }
              },
              "durability": {
                "type": "string",
                "enum": ["ephemeral", "short", "project", "durable", "foundational"]
              }
            },
            "required": ["content"]
          },
          "description": "List of observations from this session"
        },
        "session_summary": {
          "type": "string",
          "description": "Brief summary of what was accomplished"
        },
        "sequence": { "type": "string", "description": "Temporal lane for stored reflections" },
        "session_summary_cues": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "idempotency_key": {
          "type": "string",
          "description": "Stable retry key; required for remote Streamable HTTP calls"
        }
      },
      "required": ["observations"]
    }
  },
  {
    "name": "ham_context",
    "description": "Load relevant background context for a topic. Use at the start of a session to recall prior discussions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "topic": { "type": "string", "description": "Topic to load context for" },
        "max_results": { "type": "integer", "default": 8 },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" }
      },
      "required": ["topic"]
    }
  },
  {
    "name": "ham_recent",
    "description": "See recent shared work, decisions, blockers, and handoffs in the active project/repo/task context.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "types": { "type": "array", "items": { "type": "string" } },
        "source_agents": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  {
    "name": "ham_projects",
    "description": "List projects visible to the current credential, including canonical scope and repository.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "ham_whoami",
    "description": "Describe the current credential's identity, scope ceiling, visible projects, task access, and explicitly held and denied repository capabilities. Call at session start before selecting project, scope, or repository inputs.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "ham_task_post",
    "description": "Post an explicit unassigned project task with a visible goal, acceptance criteria, and declared resources.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": { "type": "string", "description": "Project slug or ID" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "goal": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "rationale": { "type": "string", "maxLength": 4000 },
        "acceptance_criteria": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
        "activity_mode": {
          "type": "string",
          "enum": ["diagnostic", "test", "production"],
          "default": "diagnostic",
          "description": "Declared activity context; visible to collaborators and never an authority grant"
        },
        "resources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 500 },
              "mode": {
                "type": "string",
                "enum": ["observe", "read", "write", "exclusive"],
                "default": "read"
              }
            },
            "required": ["key"]
          }
        },
        "tracked_item_id": { "type": "string" },
        "requester_ref": {
          "type": "string",
          "maxLength": 200,
          "description": "Represented requester reference; informational only and never an authority grant"
        },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["project", "title", "goal", "idempotency_key"]
    }
  },
  {
    "name": "ham_task_queue",
    "description": "List visible project tasks with explicit goal, claimant, run progress, lease, and resource conflicts.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": { "type": "string" },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pending",
              "claimed",
              "running",
              "needs_clarification",
              "blocked",
              "completed",
              "cancelled",
              "failed",
              "stalled"
            ]
          }
        },
        "mine": { "type": "boolean", "default": false },
        "cursor": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
      },
      "required": ["project"]
    }
  },
  {
    "name": "ham_task_get",
    "description": "Fetch one visible task and its append-only lifecycle/progress history for durable multi-run context.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "after_event_id": { "type": "integer", "minimum": 0, "default": 0 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 },
        "run_cursor": { "type": "string" }
      },
      "required": ["task_id"]
    }
  },
  {
    "name": "ham_task_claim",
    "description": "Accept a pending task with optimistic concurrency and a bounded lease; blocking resource conflicts require explicit acknowledgement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "expected_version": { "type": "integer", "minimum": 1 },
        "lease_seconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 900 },
        "acknowledge_conflict_task_ids": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string" }
        },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["task_id", "expected_version", "idempotency_key"]
    }
  },
  {
    "name": "ham_task_update",
    "description": "Start or update an owned task run, record a queue response, or reconcile completion that occurred outside a tracked run without fabricating run provenance.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "start",
            "progress",
            "block",
            "complete",
            "fail",
            "release",
            "decline",
            "request_clarification",
            "clarify",
            "force_release",
            "cancel",
            "record_external_completion"
          ]
        },
        "task_id": { "type": "string" },
        "run_id": { "type": "string" },
        "expected_version": { "type": "integer", "minimum": 1 },
        "expected_task_version": { "type": "integer", "minimum": 1 },
        "expected_run_version": { "type": "integer", "minimum": 1 },
        "claim_id": { "type": "string" },
        "intent": { "type": "string", "maxLength": 4000 },
        "summary": { "type": "string", "maxLength": 4000 },
        "requester_ref": { "type": "string", "maxLength": 200 },
        "performed_by_ref": { "type": "string", "maxLength": 200 },
        "execution_context": { "type": "object" },
        "evidence": { "type": "object" },
        "lease_seconds": { "type": "integer", "minimum": 60, "maximum": 3600, "default": 900 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["action", "task_id", "idempotency_key"],
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "start" } } },
          "then": { "required": ["expected_version", "claim_id", "intent"] }
        },
        {
          "if": {
            "properties": { "action": { "enum": ["progress", "block", "complete", "fail"] } }
          },
          "then": {
            "required": [
              "run_id",
              "expected_task_version",
              "expected_run_version",
              "claim_id",
              "summary"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "release",
                  "decline",
                  "request_clarification",
                  "clarify",
                  "force_release",
                  "cancel"
                ]
              }
            }
          },
          "then": { "required": ["expected_version"] }
        },
        {
          "if": { "properties": { "action": { "const": "record_external_completion" } } },
          "then": {
            "required": ["expected_version", "summary", "requester_ref", "performed_by_ref"]
          }
        }
      ]
    }
  },
  {
    "name": "ham_repositories",
    "description": "List enrolled repositories visible to the current credential and their mirror state.",
    "inputSchema": { "type": "object", "properties": {} }
  },
  {
    "name": "ham_repository_sync",
    "description": "Run one bounded repository poll and durable reconciliation pass; read-only agents process only remote polling.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository_id": { "type": "string" },
        "max_operations": { "type": "integer", "minimum": 1, "maximum": 50, "default": 50 }
      },
      "required": ["repository_id"]
    }
  },
  {
    "name": "ham_issue",
    "description": "Create one explicit HAM-controlled commitment and its durable GitHub mirror operation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository_id": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "body": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "labels": { "type": "array", "items": { "type": "string" } },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["repository_id", "title", "body", "idempotency_key"]
    }
  },
  {
    "name": "ham_issue_transition",
    "description": "Resolve or reopen a tracked commitment with optimistic concurrency; the mirror converges durably.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tracked_item_id": { "type": "string" },
        "state": { "type": "string", "enum": ["open", "resolved"] },
        "expected_version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 2000 }
      },
      "required": ["tracked_item_id", "state", "expected_version", "idempotency_key"]
    }
  },
  {
    "name": "ham_issue_resolve_conflict",
    "description": "Explicitly keep HAM's canonical issue state after reviewing a GitHub-side conflict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "tracked_item_id": { "type": "string" },
        "expected_version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["tracked_item_id", "expected_version", "idempotency_key"]
    }
  },
  {
    "name": "ham_review",
    "description": "Read the latest concise exception review for one enrolled repository; reviews stay outside recall.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository_id": { "type": "string" },
        "format": { "type": "string", "enum": ["markdown", "json"], "default": "markdown" }
      },
      "required": ["repository_id"]
    }
  },
  {
    "name": "ham_review_run",
    "description": "Build a deterministic exception review for one enrolled repository; returns nothing noisy on a no-op when quiet_noop is true.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository_id": { "type": "string" },
        "quiet_noop": { "type": "boolean", "default": true }
      },
      "required": ["repository_id"]
    }
  },
  {
    "name": "ham_review_current",
    "description": "List current unresolved repository exceptions, including items omitted from unchanged reports.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repository_id": { "type": "string" },
        "include_acknowledged": { "type": "boolean", "default": false }
      },
      "required": ["repository_id"]
    }
  },
  {
    "name": "ham_claim_handoff",
    "description": "Record that this agent picked up an active handoff without adding a recall memory.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["memory_id", "idempotency_key"]
    }
  },
  {
    "name": "ham_complete_handoff",
    "description": "Mark a claimed handoff complete using its current receipt version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "integer", "minimum": 1 },
        "expected_version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "required": ["memory_id", "expected_version", "idempotency_key"]
    }
  },
  {
    "name": "ham_ask",
    "description": "Send a directed asynchronous question to another agent without adding it to recall memory.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "to_agent": { "type": "string", "description": "Recipient agent ID" },
        "question": { "type": "string" },
        "project": {
          "type": "string",
          "description": "Project slug or ID; defaults to the configured stdio project or, remotely, the credential's sole authorized project"
        },
        "context_memory_ids": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "integer", "minimum": 1 },
          "description": "Deterministic HAM memory references visible to the recipient"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Stable retry key required for this write, including remote Streamable HTTP calls"
        }
      },
      "required": ["to_agent", "question", "idempotency_key"]
    }
  },
  {
    "name": "ham_inbox",
    "description": "Check directed agent messages. Call at session start; open inbox items are returned by default.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "box": { "type": "string", "enum": ["inbox", "sent", "all"], "default": "inbox" },
        "statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "enum": ["open", "answered", "stale"] },
          "default": ["open"]
        },
        "project": { "type": "string", "description": "Optional project slug or ID filter" },
        "cursor": { "type": "string" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    }
  },
  {
    "name": "ham_message",
    "description": "Fetch one directed message by its deterministic ID, including reply and provenance.",
    "inputSchema": {
      "type": "object",
      "properties": { "message_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" } },
      "required": ["message_id"]
    }
  },
  {
    "name": "ham_reply",
    "description": "Answer an open directed message using optimistic concurrency.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "answer": { "type": "string" },
        "expected_version": { "type": "integer", "minimum": 1 },
        "idempotency_key": { "type": "string" }
      },
      "required": ["message_id", "answer", "expected_version"]
    }
  },
  {
    "name": "ham_stale_message",
    "description": "Close an unanswered directed message as stale while preserving its audit history.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "expected_version": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" }
      },
      "required": ["message_id", "expected_version"]
    }
  },
  {
    "name": "ham_handoff",
    "description": "Publish a structured handoff so another agent can continue the task with completed work, next steps, blockers, and files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "completed": { "type": "array", "items": { "type": "string" } },
        "next_steps": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "array", "items": { "type": "string" } },
        "branch": { "type": "string" },
        "cues": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": "Exact agent-authored anchors; omitted means no cues"
        },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "project": { "type": "string" },
        "repo": { "type": "string" },
        "task": { "type": "string" },
        "thread": { "type": "string" },
        "sequence": { "type": "string" },
        "durability": {
          "type": "string",
          "enum": ["ephemeral", "short", "project", "durable", "foundational"],
          "default": "short"
        },
        "idempotency_key": { "type": "string" },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target_id": { "type": "integer" },
              "relation": {
                "type": "string",
                "enum": ["cites", "verifies", "contradicts", "depends-on"]
              }
            },
            "required": ["target_id", "relation"]
          }
        }
      },
      "required": ["summary"]
    }
  },
  {
    "name": "ham_changes",
    "description": "Catch up on memories created, superseded, retracted, or resolved since a cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "cursor": {
