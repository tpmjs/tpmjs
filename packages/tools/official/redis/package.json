{
  "name": "@tpmjs/tools-redis",
  "version": "0.1.0",
  "description": "Redis tools for AI agents",
  "type": "module",
  "keywords": [
    "tpmjs",
    "redis",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "@tpmjs/tool-test-utils": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "ai": "6.0.49"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tpmjs/tpmjs.git",
    "directory": "packages/tools/official/redis"
  },
  "homepage": "https://tpmjs.com",
  "license": "MIT",
  "tpmjs": {
    "category": "general",
    "frameworks": [
      "vercel-ai"
    ],
    "tools": [
      {
        "name": "exampleRedis",
        "description": "Example redis tool"
      }
    ]
  }
}
