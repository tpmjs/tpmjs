{
  "name": "@tpmjs/official-agnt",
  "version": "0.1.2",
  "description": "Agnt.gg platform tools for AI agents. Manage agents, workflows, goals, and integrations with Google, GitHub, Stripe, Notion, Twitter, YouTube, Dropbox, and more.",
  "type": "module",
  "keywords": [
    "tpmjs",
    "agnt",
    "agent",
    "workflow",
    "ai"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ai": "6.0.49"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tpmjs/tpmjs.git",
    "directory": "packages/tools/official/agnt"
  },
  "homepage": "https://tpmjs.com",
  "license": "MIT",
  "tpmjs": {
    "category": "agent",
    "frameworks": [
      "vercel-ai"
    ],
    "tools": [
      {
        "name": "googleSearch",
        "description": "Search the web using Google Custom Search API."
      },
      {
        "name": "httpRequest",
        "description": "Make HTTP requests to any API endpoint."
      },
      {
        "name": "textToSpeech",
        "description": "Convert text to speech using OpenAI TTS API."
      },
      {
        "name": "createStripeInvoice",
