{
  "name": "@tpmjs/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Example TPMJS tools for AI SDK v6",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo"
  },
  "keywords": [
    "tpmjs",
    "ai-sdk",
    "example"
  ],
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  }
}
