{
  "name": "@tpmjs/compose",
  "version": "0.1.1",
  "description": "Typed, chainable API for assembling AI SDK tool sets",
  "author": "TPMJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpmjs/tpmjs.git",
    "directory": "packages/compose"
  },
  "homepage": "https://tpmjs.com",
  "keywords": [
    "tpmjs",
    "ai-sdk",
    "tools",
    "compose",
    "builder"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/registry": {
      "types": "./dist/adapters/registry.d.ts",
      "default": "./dist/adapters/registry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --logLevel warn",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --checkers 1 --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "ai": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": false
    }
  },
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tpmjs/tsconfig": "workspace:*",
    "ai": "6.0.49",
    "typescript": "catalog:",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
