{
  "extends": "@tpmjs/tsconfig/nextjs.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/.well-known/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
