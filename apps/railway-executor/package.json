{
  "name": "railway-executor",
  "version": "1.0.0",
  "description": "TPMJS on-box dynamic tool executor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-run --allow-sys --allow-ffi server.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write --allow-run --allow-sys --allow-ffi server.ts"
  }
}
