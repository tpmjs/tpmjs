{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "exclude": ["duplicates"],
  "ignoreExportsUsedInFile": true,
  "ignoreFiles": [
    ".claude/**",
    "docs/PLANNER_TYPE_DEFINITIONS.ts",
    "packages/tools/official/*/block.ts",
    "packages/tools/official/*/index.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "examples/**/*.{ts,tsx,js,mjs,cjs}",
        "scripts/manual-tools.ts",
        "reset.d.ts",
        "scripts/**/*.{ts,tsx,js,mjs,cjs}",
        "templates/**/*.{ts,tsx,js,mjs,cjs}",
        "vitest.coverage.config.ts"
      ],
      "ignoreDependencies": ["@vitest/coverage-v8"]
    },
    "apps/railway-executor": {
      "entry": ["server.ts"]
    },
    "examples/sdk": {},
    "packages/db": {
      "entry": ["*.{js,mjs,cjs}", "prisma/*.ts", "scripts/**/*.ts"]
    },
    "packages/config/tsconfig": {
      "ignoreUnresolved": ["next"]
    },
    "packages/video": {
      "entry": ["remotion.config.ts", "src/index.ts"]
    },
    "services/sandbox-executor": {}
  }
}
