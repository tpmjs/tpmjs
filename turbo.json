{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json", "tsdown.config.ts"],
  "futureFlags": {
    "affectedUsingTaskInputs": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**/*.tsbuildinfo", "*.tsbuildinfo", ".next/cache/tsconfig.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#test:coverage": {
      "inputs": [
        "apps/**/package.json",
        "apps/**/src/**",
        "apps/**/vitest.config.*",
        "packages/**/package.json",
        "packages/**/src/**",
        "packages/**/vitest.config.*",
        "scripts/coverage-baselines.ts",
        "scripts/coverage-workspaces.ts",
        "scripts/test-coverage.ts",
        "vitest.coverage.config.ts"
      ],
      "outputs": ["coverage/**"]
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
