# keep host artifacts out of image builds (donto-infra/build/tpmjs.Dockerfile)
node_modules
**/node_modules
**/.next
.git
**/dist
.turbo
**/.turbo
**/coverage
**/*.log
# Keep local credentials out of the image context. The three production files
# contain only NEXT_PUBLIC build values generated by the deployment procedure.
**/.env*
!apps/web/.env.production
!apps/playground/.env.production
!apps/tutorial/.env.production
